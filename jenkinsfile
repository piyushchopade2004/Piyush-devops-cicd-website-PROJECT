pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git 'https://github.com/piyushchopade2004/Piyush-devops-cicd-website-PROJECT.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t devops-website .'
            }
        }

        stage('Remove Old Container') {
            steps {
                sh 'docker rm -f website-container || true'
            }
        }

        stage('Deploy Container') {
            steps {
                sh 'docker run -d --name website-container -p 80:80 devops-website'
            }
        }
    }
}
